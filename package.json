{
  "name": "tracedojo-sdk-workspace",
  "private": true,
  "version": "0.1.1",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "scripts": {
    "build": "npm run build --workspace @tracedojo/sdk",
    "pretest": "npm run build",
    "test": "tsx --test tests/*.test.ts",
    "test:sdk-install": "node scripts/test-sdk-install.mjs",
    "test:npx-install": "node scripts/test-npx-install.mjs"
  },
  "devDependencies": {
    "@langchain/core": "1.2.11",
    "@types/node": "22.20.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "zod": "4.6.2"
  }
}
