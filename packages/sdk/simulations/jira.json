{
  "schemaVersion": "simulation/1",
  "id": "jira",
  "title": "Jira issues",
  "api": {
    "name": "Jira Cloud platform REST API",
    "version": "3",
    "docs": "https://developer.atlassian.com/cloud/jira/platform/rest/v3/api-group-issues/"
  },
  "epoch": 1731650000,
  "collections": {
    "issues": {
      "unique": [
        [
          "id"
        ],
        [
          "key"
        ]
      ],
      "conflict": "bad_request"
    }
  },
  "state": {
    "issues": [
      {
        "id": "10041",
        "key": "OPS-41",
        "self": "https://shop.atlassian.net/rest/api/3/issue/10041",
        "fields": {
          "summary": "INC-41: search is slow",
          "description": null,
          "status": {
            "name": "In Progress"
          },
          "issuetype": {
            "name": "Bug"
          },
          "project": {
            "key": "OPS"
          },
          "labels": [
            "inc-41"
          ],
          "created": "2024-11-13T08:00:00.000+0000",
          "updated": "2024-11-13T08:00:00.000+0000",
          "comments": []
        }
      }
    ]
  },
  "errors": {
    "bad_request": {
      "code": "bad_request",
      "message": "{{field}}: invalid value",
      "status": 400,
      "retryable": false,
      "verified": false
    },
    "invalid_project": {
      "code": "bad_request",
      "message": "valid project is required",
      "status": 400,
