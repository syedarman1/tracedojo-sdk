  },
  "epoch": 1731650000,
  "collections": {
    "incidents": {
      "unique": [
        [
          "id"
        ]
      ],
      "conflict": "invalid_event"
    }
  },
  "state": {
    "incidents": [
      {
        "id": "Q0000000001041",
        "type": "incident",
