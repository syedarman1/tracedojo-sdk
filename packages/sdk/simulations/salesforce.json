  "agent": {
    "bug": "POST always inserts and External_Id__c is not unique. The broken agent retries a create whose confirmation was lost without querying for shop-7 first, so Jordan ends up as two contacts. (Upserting on External_Id__c, or querying before retrying, avoids it.)",
    "bugScenario": "lost-confirmation",
    "fixed": {
      "steps": [
        {
          "call": "salesforce_query",
          "args": {
            "sobject": "Contact",
            "where": [
              {
                "field": "External_Id__c",
                "op": "in",
                "value": [
                  "shop-7",
                  "shop-8"
                ]
              }
            ]
          },
          "attempts": 3,
          "save": "before"
        },
        {
          "call": "salesforce_sobject_create",
          "args": {
            "sobject": "Contact",
            "fields": {
              "FirstName": "Jordan",
              "LastName": "Lee",
              "Email": "jordan@example.com",
              "External_Id__c": "shop-7"
            }
          },
          "attempts": 3,
          "save": "jordan",
          "beforeRetry": {
            "call": "salesforce_query",
            "args": {
              "sobject": "Contact",
              "where": [
                {
                  "field": "External_Id__c",
                  "op": "eq",
                  "value": "shop-7"
                }
              ]
            },
            "find": {
              "path": "/records",
              "where": {}
            }
          }
        },
        {
          "call": "salesforce_sobject_upsert",
          "args": {
            "sobject": "Contact",
            "externalIdField": "External_Id__c",
            "externalId": "shop-8",
            "fields": {
              "Phone": "+1 415 555 0188"
            }
          },
          "attempts": 3
        },
        {
          "call": "salesforce_query",
          "args": {
            "sobject": "Contact",
            "where": [
              {
                "field": "External_Id__c",
                "op": "in",
                "value": [
                  "shop-7",
                  "shop-8"
                ]
              }
            ]
          },
          "attempts": 3,
          "save": "after",
          "until": {
            "path": "/totalSize",
            "equals": 2
          }
        }
      ],
      "output": "{{saved.after}}",
      "message": "Created Jordan once and updated Riley by external ID."
    },
    "broken": {
