  "tools": {
    "salesforce_query": {
      "kind": "read",
      "description": "GET /services/data/v62.0/query. Instead of SOQL text, takes sobject and where filters (ANDed; ops eq, neq, in), returning every field.",
      "input": {
        "type": "object",
        "properties": {
          "sobject": {
            "type": "string",
            "minLength": 1
          },
          "where": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1
                },
                "op": {
                  "type": "string",
                  "enum": [
                    "eq",
                    "neq",
                    "in"
                  ]
                },
                "value": {
                  "type": "any"
                }
              },
              "required": [
                "field",
                "op",
                "value"
              ],
              "additionalProperties": false
            },
            "maxItems": 20
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000
          }
        },
        "required": [
          "sobject"
        ],
        "additionalProperties": false
      },
      "invalid": {
        "missing": "json_parser_error",
        "unknown": "unknown_input",
        "type": "json_parser_error"
      },
      "steps": [
        {
          "require": {
            "$eq": [
              {
                "$": "args.sobject"
              },
              "Contact"
            ]
          },
          "error": "unsupported_type"
        },
        {
          "each": {
            "$coalesce": [
              {
                "$": "args.where"
              },
              []
            ]
          },
          "as": "w",
          "do": [
            {
              "let": {
                "field": {
                  "$": "w.field"
                }
              }
            },
            {
              "require": {
                "$in": [
                  {
                    "$": "w.field"
                  },
                  [
                    "Id",
                    "CreatedDate",
                    "LastModifiedDate",
                    "FirstName",
                    "LastName",
                    "Email",
                    "Phone",
                    "External_Id__c"
                  ]
                ]
              },
              "error": "invalid_field"
            }
          ]
        },
        {
          "filter": "contacts",
          "as": "rows",
          "limit": {
            "$": "args.limit"
          },
          "where": {
            "$filters": [
              {
                "$": "item"
              },
              {
                "$map": [
                  {
                    "$coalesce": [
                      {
                        "$": "args.where"
                      },
                      []
                    ]
                  },
                  {
                    "column": {
                      "$": "item.field"
                    },
                    "op": {
                      "$": "item.op"
                    },
                    "value": {
                      "$": "item.value"
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "return": {
            "totalSize": {
              "$len": {
                "$": "rows"
              }
            },
            "done": true,
            "records": {
              "$": "rows"
            }
          }
        }
      ]
    },
