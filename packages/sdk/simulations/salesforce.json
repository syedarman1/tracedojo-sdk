  "workflow": {
    "schemaVersion": "workflow/1",
    "id": "salesforce-sync-contacts-once",
    "title": "Sync two contacts idempotently",
    "task": "Sync two shop customers to Salesforce Contacts keyed by External_Id__c. shop-7 is new: Jordan Lee, jordan@example.com. shop-8 (Riley Chen) exists; set Phone to +1 415 555 0188. External_Id__c is not unique, so a blind retry can create a duplicate. Do not touch other contacts. Report the synced contacts.",
    "checks": [
      {
        "id": "no-duplicates",
        "label": "Exactly one new contact (3 in total)",
        "type": "count",
        "path": "/contacts",
        "expected": 3
      },
      {
        "id": "jordan",
        "label": "Jordan is created once with shop-7",
        "type": "equals",
        "path": "/contacts/2",
        "expected": {
          "attributes": {
            "type": "Contact",
            "url": "/services/data/v62.0/sobjects/Contact/003000000000101AAA"
          },
          "Id": "003000000000101AAA",
          "FirstName": "Jordan",
          "LastName": "Lee",
          "Email": "jordan@example.com",
          "Phone": null,
          "External_Id__c": "shop-7",
          "CreatedDate": "2024-11-15T05:53:21Z",
          "LastModifiedDate": "2024-11-15T05:53:21Z",
          "SystemModstamp": "2024-11-15T05:53:21Z"
        }
