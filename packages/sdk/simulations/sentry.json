  "tools": {
    "sentry_issues_list": {
      "kind": "read",
      "description": "GET /api/0/projects/{org}/{project}/issues/. Instead of a search query such as is:unresolved, takes status. Most recently seen first.",
      "input": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "unresolved",
              "resolved",
              "ignored"
            ]
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "invalid": "invalid_request",
      "steps": [
        {
          "filter": "issues",
          "where": {
            "$or": [
              {
                "$eq": [
                  {
                    "$": "args.status"
                  },
                  null
                ]
              },
              {
                "$eq": [
                  {
                    "$": "item.status"
                  },
                  {
                    "$": "args.status"
                  }
                ]
              }
            ]
          },
          "as": "found",
          "order": {
            "by": "lastSeen",
            "desc": true
          }
        },
        {
          "return": {
            "$": "found"
          }
        }
      ]
    },
    "sentry_issue_get": {
      "kind": "read",
      "description": "GET /api/0/organizations/{org}/issues/{issue_id}/ (subset of fields).",
      "input": {
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "issue_id"
        ],
        "additionalProperties": false
      },
      "invalid": "invalid_request",
      "steps": [
        {
          "find": "issues",
          "where": {
            "$eq": [
              {
                "$": "item.id"
              },
              {
                "$": "args.issue_id"
              }
            ]
          },
          "as": "issue",
          "missing": "not_found"
        },
        {
          "return": {
            "$": "issue"
          }
        }
      ]
    },
    "sentry_issue_update": {
      "kind": "write",
      "description": "PUT /api/0/organizations/{org}/issues/{issue_id}/. Only the attributes sent change; resolving an issue that is already resolved changes nothing. assignedTo takes user:<id> or an email, or null to unassign.",
      "input": {
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "resolved",
              "unresolved",
              "ignored",
              "resolvedInNextRelease",
              "muted"
            ]
          },
          "assignedTo": {
            "type": "any"
          },
          "hasSeen": {
            "type": "boolean"
          },
          "isBookmarked": {
            "type": "boolean"
          }
        },
        "required": [
          "issue_id"
        ],
        "additionalProperties": false
      },
      "invalid": "invalid_request",
      "steps": [
        {
          "find": "issues",
          "where": {
            "$eq": [
              {
                "$": "item.id"
              },
              {
                "$": "args.issue_id"
              }
            ]
          },
          "as": "issue",
          "missing": "not_found"
        },
        {
          "let": {
            "assignee": {
              "$": "issue.assignedTo"
            }
          }
        },
        {
          "if": {
            "$ne": [
              {
                "$type": {
                  "$": "args.assignedTo"
                }
              },
              "null"
            ]
          },
          "then": [
            {
              "let": {
                "assignee": {
                  "$coalesce": [
                    {
                      "$if": [
                        {
                          "$eq": [
                            {
                              "$": "args.assignedTo"
                            },
                            "user:11"
                          ]
                        },
                        {
                          "type": "user",
                          "id": "11",
                          "name": "Maya Ortiz",
                          "email": "maya@shop.example"
                        },
                        null
                      ]
                    },
                    {
                      "$if": [
                        {
                          "$eq": [
                            {
                              "$": "args.assignedTo"
                            },
                            "user:12"
                          ]
                        },
                        {
                          "type": "user",
                          "id": "12",
                          "name": "Sam Rivera",
                          "email": "sam@shop.example"
                        },
                        null
                      ]
                    },
                    {
                      "$if": [
                        {
                          "$eq": [
                            {
                              "$": "args.assignedTo"
                            },
                            "maya@shop.example"
                          ]
                        },
                        {
                          "type": "user",
                          "id": "11",
                          "name": "Maya Ortiz",
                          "email": "maya@shop.example"
                        },
                        null
                      ]
                    },
                    {
                      "$if": [
                        {
                          "$eq": [
                            {
                              "$": "args.assignedTo"
                            },
                            "sam@shop.example"
                          ]
                        },
                        {
                          "type": "user",
                          "id": "12",
                          "name": "Sam Rivera",
                          "email": "sam@shop.example"
                        },
                        null
                      ]
                    },
                    null
                  ]
                }
              }
            },
            {
              "require": {
                "$": "assignee"
              },
              "error": "unknown_assignee"
            }
          ]
        },
        {
          "if": {
            "$and": [
              {
                "$in": [
                  "assignedTo",
                  {
                    "$keys": {
                      "$": "args"
                    }
                  }
                ]
              },
              {
                "$eq": [
                  {
                    "$type": {
                      "$": "args.assignedTo"
                    }
                  },
                  "null"
                ]
              }
            ]
          },
          "then": [
            {
              "let": {
                "assignee": null
              }
            }
          ]
        },
        {
          "let": {
            "next": {
              "$merge": [
                {
                  "$": "issue"
                },
                {
                  "assignedTo": {
                    "$": "assignee"
                  },
                  "hasSeen": {
                    "$coalesce": [
                      {
                        "$": "args.hasSeen"
                      },
                      {
                        "$": "issue.hasSeen"
                      }
                    ]
                  }
                }
              ]
            }
          }
        },
        {
          "if": {
            "$": "args.status"
          },
          "then": [
            {
              "let": {
                "next": {
                  "$merge": [
                    {
                      "$": "next"
                    },
                    {
                      "status": {
                        "$if": [
                          {
                            "$eq": [
                              {
                                "$": "args.status"
                              },
                              "resolved"
                            ]
                          },
                          "resolved",
                          {
                            "$if": [
                              {
                                "$eq": [
                                  {
                                    "$": "args.status"
                                  },
                                  "resolvedInNextRelease"
                                ]
                              },
                              "resolved",
                              {
                                "$if": [
                                  {
                                    "$eq": [
                                      {
                                        "$": "args.status"
                                      },
                                      "unresolved"
                                    ]
                                  },
                                  "unresolved",
                                  "ignored"
                                ]
                              }
                            ]
                          }
                        ]
                      },
                      "substatus": {
                        "$if": [
                          {
                            "$eq": [
                              {
                                "$": "args.status"
                              },
                              "resolved"
                            ]
                          },
                          null,
                          {
                            "$if": [
                              {
                                "$eq": [
                                  {
                                    "$": "args.status"
                                  },
                                  "resolvedInNextRelease"
                                ]
                              },
                              null,
                              {
                                "$if": [
                                  {
                                    "$eq": [
                                      {
                                        "$": "args.status"
                                      },
                                      "unresolved"
                                    ]
                                  },
                                  "ongoing",
                                  "archived_forever"
                                ]
                              }
                            ]
                          }
                        ]
                      },
                      "statusDetails": {
                        "$if": [
                          {
                            "$eq": [
                              {
                                "$": "args.status"
                              },
                              "resolved"
                            ]
                          },
                          {},
                          {
                            "$if": [
                              {
                                "$eq": [
                                  {
                                    "$": "args.status"
                                  },
                                  "resolvedInNextRelease"
                                ]
                              },
                              {
                                "inNextRelease": true
                              },
                              {
                                "$if": [
                                  {
                                    "$eq": [
                                      {
                                        "$": "args.status"
                                      },
                                      "unresolved"
                                    ]
                                  },
                                  {},
                                  {}
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "if": {
            "$ne": [
              {
                "$": "next"
              },
              {
                "$": "issue"
              }
            ]
          },
          "then": [
            {
              "update": "issue",
              "set": {
                "status": {
                  "$": "next.status"
                },
                "substatus": {
                  "$": "next.substatus"
                },
                "statusDetails": {
                  "$": "next.statusDetails"
                },
                "assignedTo": {
                  "$": "next.assignedTo"
                },
                "hasSeen": {
                  "$": "next.hasSeen"
                }
              }
            }
          ]
        },
        {
          "return": {
            "$": "issue"
          }
        }
      ]
    },
    "sentry_issue_comment_create": {
      "kind": "write",
      "description": "POST /api/0/issues/{issue_id}/comments/ with text. Each call adds a note; a retry adds a second one.",
      "input": {
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "issue_id",
          "text"
        ],
        "additionalProperties": false
      },
      "invalid": "invalid_request",
      "steps": [
        {
          "find": "issues",
          "where": {
            "$eq": [
              {
                "$": "item.id"
              },
              {
                "$": "args.issue_id"
              }
            ]
          },
          "as": "issue",
          "missing": "not_found"
        },
        {
          "let": {
            "id": {
              "$concat": [
                {
                  "$add": [
                    880000,
                    {
                      "$seq": "activity"
                    }
                  ]
                },
                ""
              ]
            }
          }
        },
        {
          "insert": "comments",
          "value": {
            "id": {
              "$": "id"
            },
            "issue": {
              "$": "args.issue_id"
            },
            "type": "note",
            "data": {
              "text": {
                "$": "args.text"
              }
            },
            "user": {
              "id": "99",
              "name": "Ops Bot"
            },
            "dateCreated": {
              "$isotime": true
            }
          },
          "as": "note"
        },
        {
          "update": "issue",
          "set": {
            "numComments": {
              "$add": [
                {
                  "$": "item.numComments"
                },
                1
              ]
            }
          }
        },
        {
          "return": {
            "$pick": [
              {
                "$": "note"
              },
              [
                "id",
                "type",
                "data",
                "user",
                "dateCreated"
              ]
            ]
          }
        }
      ]
    },
    "sentry_issue_comments_list": {
      "kind": "read",
      "description": "GET /api/0/issues/{issue_id}/comments/, newest first.",
      "input": {
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "issue_id"
        ],
        "additionalProperties": false
      },
      "invalid": "invalid_request",
      "steps": [
        {
          "find": "issues",
          "where": {
            "$eq": [
              {
                "$": "item.id"
              },
              {
                "$": "args.issue_id"
              }
            ]
          },
          "as": "issue",
          "missing": "not_found"
        },
        {
          "filter": "comments",
          "where": {
            "$eq": [
              {
                "$": "item.issue"
              },
              {
                "$": "args.issue_id"
              }
            ]
          },
          "as": "found",
          "order": {
            "by": "id",
            "desc": true
          }
        },
        {
          "return": {
            "$map": [
              {
                "$": "found"
              },
              {
                "$pick": [
                  {
                    "$": "item"
                  },
                  [
                    "id",
                    "type",
                    "data",
                    "user",
                    "dateCreated"
                  ]
                ]
              }
            ]
          }
        }
      ]
    }
  },
  "workflow": {
    "schemaVersion": "workflow/1",
    "id": "sentry-resolve-once",
    "title": "Resolve an issue and note it once",
    "task": "Deploy d-9f2 fixed Sentry issue CHECKOUT-4F (id 4501). Leave exactly one comment, 'Fixed by deploy d-9f2 (null check in card tokenization). Resolving.', then resolve it and assign it to maya@shop.example. Do not touch other issues. Report the issue.",
    "checks": [
      {
        "id": "resolved",
        "label": "CHECKOUT-4F is resolved and assigned to Maya",
        "type": "equals",
        "path": "/issues/0",
        "expected": {
          "id": "4501",
          "shortId": "CHECKOUT-4F",
          "title": "TypeError: Cannot read properties of null (reading 'token')",
          "culprit": "tokenizeCard(checkout/payments)",
          "permalink": "https://shop.sentry.io/issues/4501/",
          "level": "error",
          "status": "resolved",
          "statusDetails": {},
          "substatus": null,
          "project": {
            "id": "201",
            "slug": "checkout",
            "name": "checkout"
          },
          "count": "342",
          "userCount": 57,
          "firstSeen": "2024-11-15T03:12:00Z",
          "lastSeen": "2024-11-15T05:40:00Z",
          "assignedTo": {
            "type": "user",
            "id": "11",
