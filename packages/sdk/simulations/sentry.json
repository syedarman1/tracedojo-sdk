  "agent": {
    "bug": "Comments are not idempotent. The broken agent retries a comment whose confirmation was lost without listing comments first, so the issue gets the same note twice.",
    "bugScenario": "lost-confirmation",
    "fixed": {
      "steps": [
        {
          "call": "sentry_issue_get",
          "args": {
            "issue_id": "4501"
          },
          "attempts": 3,
          "save": "issue"
        },
        {
          "call": "sentry_issue_comments_list",
          "args": {
            "issue_id": "4501"
          },
          "attempts": 3,
          "save": "before"
        },
        {
          "call": "sentry_issue_comment_create",
          "args": {
            "issue_id": "4501",
            "text": "Fixed by deploy d-9f2 (null check in card tokenization). Resolving."
          },
          "attempts": 3,
          "save": "note",
          "beforeRetry": {
            "call": "sentry_issue_comments_list",
            "args": {
              "issue_id": "4501"
            },
            "find": {
              "path": "",
              "where": {
                "/data/text": "Fixed by deploy d-9f2 (null check in card tokenization). Resolving."
              }
            }
          }
        },
        {
          "call": "sentry_issue_update",
          "args": {
            "issue_id": "4501",
            "status": "resolved",
            "assignedTo": "maya@shop.example"
          },
          "attempts": 3,
          "save": "resolved"
        },
        {
          "call": "sentry_issue_comments_list",
          "args": {
            "issue_id": "4501"
          },
          "attempts": 3,
          "save": "after",
