    {
      "name": "merge then read",
      "calls": [
        {
          "tool": "github_merge_pull_request",
          "args": {
            "owner": "acme",
            "repo": "shop",
            "pull_number": 42,
            "merge_method": "squash"
          },
          "expect": {
            "ok": true,
            "data": {
              "sha": "5e00000000000000000000000000000000000001",
              "merged": true,
              "message": "Pull Request successfully merged"
            }
          }
        },
        {
          "tool": "github_get_pull_request",
          "args": {
            "owner": "acme",
            "repo": "shop",
            "pull_number": 42
          },
          "expect": {
            "ok": true,
            "data": {
              "number": 42,
              "state": "closed",
              "title": "Fix checkout retries",
              "body": "Retries checkout calls with an idempotency key.",
