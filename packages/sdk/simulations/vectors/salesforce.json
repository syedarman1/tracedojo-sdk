            "externalId": "shop-9",
            "fields": {
              "LastName": "Park",
              "Email": "casey@example.com"
            }
          },
          "expect": {
            "ok": true,
            "data": {
              "id": "003000000000101AAA",
              "success": true,
              "errors": [],
              "created": true
            }
          }
        },
        {
          "tool": "salesforce_sobject_upsert",
          "args": {
            "sobject": "Contact",
            "externalIdField": "External_Id__c",
            "externalId": "shop-9",
            "fields": {
              "LastName": "Park",
              "Phone": "1"
            }
          },
          "expect": {
            "ok": true,
            "data": {
              "id": "003000000000101AAA",
              "success": true,
              "errors": [],
              "created": false
            }
          }
        },
        {
          "tool": "salesforce_sobject_upsert",
          "args": {
            "sobject": "Contact",
            "externalIdField": "External_Id__c",
            "externalId": "shop-9",
            "fields": {
              "LastName": "Park",
              "Phone": "1"
            }
          },
          "expect": {
            "ok": true,
            "data": {
              "id": "003000000000101AAA",
              "success": true,
              "errors": [],
              "created": false
            }
          }
        }
      ],
      "stateAfter": {
        "/contacts/2": {
          "attributes": {
            "type": "Contact",
            "url": "/services/data/v62.0/sobjects/Contact/003000000000101AAA"
          },
          "Id": "003000000000101AAA",
          "FirstName": null,
          "LastName": "Park",
          "Email": "casey@example.com",
          "Phone": "1",
          "External_Id__c": "shop-9",
          "CreatedDate": "2024-11-15T05:53:21Z",
          "LastModifiedDate": "2024-11-15T05:53:21Z",
          "SystemModstamp": "2024-11-15T05:53:21Z"
        }
      }
