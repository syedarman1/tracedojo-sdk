    {
      "name": "create twice duplicates, then upsert is ambiguous",
      "calls": [
        {
          "tool": "salesforce_sobject_create",
          "args": {
            "sobject": "Contact",
            "fields": {
              "LastName": "Lee",
              "External_Id__c": "shop-7"
            }
          },
          "expect": {
            "ok": true,
            "data": {
              "id": "003000000000101AAA",
              "success": true,
              "errors": []
            }
          }
        },
        {
          "tool": "salesforce_sobject_create",
          "args": {
            "sobject": "Contact",
            "fields": {
              "LastName": "Lee",
              "External_Id__c": "shop-7"
            }
          },
          "expect": {
            "ok": true,
            "data": {
              "id": "003000000000102AAA",
              "success": true,
              "errors": []
            }
          }
        },
        {
          "tool": "salesforce_sobject_upsert",
          "args": {
            "sobject": "Contact",
            "externalIdField": "External_Id__c",
            "externalId": "shop-7",
            "fields": {
              "Phone": "2"
            }
          },
          "expect": {
            "ok": false,
            "error": {
              "code": "MULTIPLE_CHOICES",
              "message": "More than one record found for External_Id__c",
              "retryable": false
            }
          }
        },
        {
          "tool": "salesforce_query",
          "args": {
            "sobject": "Contact",
            "where": [
              {
                "field": "External_Id__c",
                "op": "eq",
                "value": "shop-7"
              }
            ]
          },
          "expect": {
            "ok": true,
            "data": {
              "totalSize": 2,
              "done": true,
              "records": [
                {
                  "attributes": {
                    "type": "Contact",
                    "url": "/services/data/v62.0/sobjects/Contact/003000000000101AAA"
                  },
                  "Id": "003000000000101AAA",
                  "FirstName": null,
                  "LastName": "Lee",
                  "Email": null,
                  "Phone": null,
                  "External_Id__c": "shop-7",
                  "CreatedDate": "2024-11-15T05:53:21Z",
                  "LastModifiedDate": "2024-11-15T05:53:21Z",
                  "SystemModstamp": "2024-11-15T05:53:21Z"
                },
                {
                  "attributes": {
                    "type": "Contact",
                    "url": "/services/data/v62.0/sobjects/Contact/003000000000102AAA"
                  },
                  "Id": "003000000000102AAA",
                  "FirstName": null,
                  "LastName": "Lee",
                  "Email": null,
                  "Phone": null,
                  "External_Id__c": "shop-7",
                  "CreatedDate": "2024-11-15T05:53:22Z",
                  "LastModifiedDate": "2024-11-15T05:53:22Z",
                  "SystemModstamp": "2024-11-15T05:53:22Z"
                }
              ]
            }
          }
        }
      ],
      "stateAfter": {}
