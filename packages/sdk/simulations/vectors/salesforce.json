    {
      "name": "required field, external id in body, unknown field",
      "calls": [
        {
          "tool": "salesforce_sobject_create",
          "args": {
            "sobject": "Contact",
            "fields": {
              "FirstName": "No"
            }
          },
          "expect": {
            "ok": false,
            "error": {
              "code": "REQUIRED_FIELD_MISSING",
              "message": "Required fields are missing: [LastName]",
              "retryable": false
            }
          }
        },
        {
          "tool": "salesforce_sobject_upsert",
          "args": {
            "sobject": "Contact",
            "externalIdField": "External_Id__c",
            "externalId": "shop-8",
            "fields": {
              "External_Id__c": "shop-9"
            }
          },
          "expect": {
            "ok": false,
            "error": {
              "code": "INVALID_FIELD",
              "message": "The external ID field must not be set in the request body",
              "retryable": false
            }
          }
        },
        {
          "tool": "salesforce_sobject_create",
          "args": {
            "sobject": "Contact",
            "fields": {
              "LastName": "X",
              "Fax": "1"
            }
          },
          "expect": {
            "ok": false,
            "error": {
              "code": "INVALID_FIELD",
              "message": "No such field fields.Fax on sobject of type Contact",
              "retryable": false
            }
          }
        },
        {
          "tool": "salesforce_query",
          "args": {
            "sobject": "Contact",
            "where": [
              {
                "field": "Fax",
                "op": "eq",
                "value": "1"
              }
            ]
          },
          "expect": {
            "ok": false,
            "error": {
              "code": "INVALID_FIELD",
              "message": "No such column 'Fax' on sobject of type Contact",
              "retryable": false
            }
          }
        }
      ],
      "stateAfter": {}
    },
