                "type": "message",
                "subtype": "bot_message",
                "user": "U0TRACEDOJO",
                "bot_id": "B0TRACEDOJO",
                "text": "hi",
                "ts": "1731650002.000002"
              }
            }
          }
        }
      ],
      "stateAfter": {
        "/messages": [
          {
            "channel": "C0OPS",
            "type": "message",
            "user": "U0ALEX",
            "text": "INC-7: checkout errors after deploy 41. Deploy 42 has the fix.",
            "ts": "1731649000.000100"
          },
          {
            "channel": "C0RANDOM",
            "type": "message",
            "user": "U0SAM",
            "text": "Lunch at noon?",
            "ts": "1731649100.000200"
          },
          {
            "channel": "C0OPS",
            "type": "message",
            "subtype": "bot_message",
            "user": "U0TRACEDOJO",
            "bot_id": "B0TRACEDOJO",
            "text": "hi",
            "ts": "1731650001.000001"
          },
          {
            "channel": "C0OPS",
            "type": "message",
            "subtype": "bot_message",
            "user": "U0TRACEDOJO",
            "bot_id": "B0TRACEDOJO",
            "text": "hi",
            "ts": "1731650002.000002"
          }
