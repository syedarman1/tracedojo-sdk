                "bot_id": "B0TRACEDOJO",
                "text": "hi",
                "ts": "1731650001.000001"
              }
            }
          }
        },
        {
          "tool": "slack_chat_postMessage",
          "args": {
            "channel": "C0OPS",
            "text": "hi"
          },
          "expect": {
            "ok": true,
            "data": {
              "ok": true,
              "channel": "C0OPS",
