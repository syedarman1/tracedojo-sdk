    },
    {
      "name": "reaction then already_reacted",
      "calls": [
        {
          "tool": "slack_reactions_add",
          "args": {
            "channel": "C0OPS",
            "timestamp": "1731649000.000100",
            "name": "eyes"
          },
          "expect": {
            "ok": true,
            "data": {
              "ok": true
            }
          }
        },
        {
          "tool": "slack_reactions_add",
          "args": {
            "channel": "C0OPS",
            "timestamp": "1731649000.000100",
            "name": "eyes"
          },
          "expect": {
            "ok": false,
            "error": {
              "code": "already_reacted",
              "message": "already_reacted",
              "retryable": false
            }
          }
        }
      ],
      "stateAfter": {
        "/messages/0": {
          "channel": "C0OPS",
          "type": "message",
          "user": "U0ALEX",
          "text": "INC-7: checkout errors after deploy 41. Deploy 42 has the fix.",
          "ts": "1731649000.000100",
          "reactions": [
            {
              "name": "eyes",
              "users": [
                "U0TRACEDOJO"
              ],
              "count": 1
            }
          ]
        }
      }
    },
