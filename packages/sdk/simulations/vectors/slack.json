            }
          }
        }
      ],
      "stateAfter": {}
    },
    {
      "name": "argument errors",
      "calls": [
        {
          "tool": "slack_chat_postMessage",
          "args": {
            "channel": "C0OPS"
          },
          "expect": {
            "ok": false,
            "error": {
              "code": "no_text",
