{
  "schemaVersion": "simulation-vectors/1",
  "simulation": "slack",
  "cases": [
    {
      "name": "post then read history",
      "calls": [
        {
          "tool": "slack_chat_postMessage",
          "args": {
            "channel": "C0OPS",
            "text": "hi"
          },
          "expect": {
            "ok": true,
            "data": {
              "ok": true,
              "channel": "C0OPS",
              "ts": "1731650001.000001",
              "message": {
                "type": "message",
                "subtype": "bot_message",
                "user": "U0TRACEDOJO",
                "bot_id": "B0TRACEDOJO",
                "text": "hi",
                "ts": "1731650001.000001"
              }
            }
          }
        },
        {
          "tool": "slack_conversations_history",
          "args": {
            "channel": "C0OPS",
            "limit": 1
          },
          "expect": {
            "ok": true,
            "data": {
              "ok": true,
              "messages": [
                {
                  "type": "message",
                  "subtype": "bot_message",
                  "user": "U0TRACEDOJO",
                  "bot_id": "B0TRACEDOJO",
                  "text": "hi",
                  "ts": "1731650001.000001"
                }
              ],
              "has_more": true,
              "pin_count": 0,
              "response_metadata": {
                "next_cursor": ""
              }
            }
          }
        }
      ],
      "stateAfter": {
        "/messages": [
          {
            "channel": "C0OPS",
            "type": "message",
            "user": "U0ALEX",
            "text": "INC-7: checkout errors after deploy 41. Deploy 42 has the fix.",
            "ts": "1731649000.000100"
          },
          {
            "channel": "C0RANDOM",
            "type": "message",
            "user": "U0SAM",
            "text": "Lunch at noon?",
            "ts": "1731649100.000200"
          },
          {
            "channel": "C0OPS",
            "type": "message",
            "subtype": "bot_message",
            "user": "U0TRACEDOJO",
            "bot_id": "B0TRACEDOJO",
            "text": "hi",
            "ts": "1731650001.000001"
          }
        ]
      }
    },
    {
