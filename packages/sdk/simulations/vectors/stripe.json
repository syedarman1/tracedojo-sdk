{
  "schemaVersion": "simulation-vectors/1",
  "simulation": "stripe",
  "cases": [
    {
      "name": "partial refund, then list and read back",
      "calls": [
        {
          "tool": "stripe_create_refund",
          "args": {
            "payment_intent": "pi_7",
            "amount": 500,
            "reason": "requested_by_customer",
            "idempotency_key": "k1"
          },
          "expect": {
            "ok": true,
            "data": {
              "id": "re_000000000000000000000001",
              "object": "refund",
              "amount": 500,
              "balance_transaction": "txn_000000000000000000000001",
              "charge": "ch_7",
              "created": 1731650002,
              "currency": "usd",
              "metadata": {},
              "payment_intent": "pi_7",
              "reason": "requested_by_customer",
              "receipt_number": null,
              "source_transfer_reversal": null,
              "status": "succeeded",
              "transfer_reversal": null
            }
          }
        },
        {
          "tool": "stripe_list_refunds",
          "args": {
            "payment_intent": "pi_7"
          },
          "expect": {
            "ok": true,
            "data": {
              "object": "list",
              "data": [
                {
                  "id": "re_000000000000000000000001",
                  "object": "refund",
                  "amount": 500,
                  "balance_transaction": "txn_000000000000000000000001",
                  "charge": "ch_7",
                  "created": 1731650002,
                  "currency": "usd",
                  "metadata": {},
                  "payment_intent": "pi_7",
                  "reason": "requested_by_customer",
                  "receipt_number": null,
                  "source_transfer_reversal": null,
                  "status": "succeeded",
                  "transfer_reversal": null
                }
              ],
              "has_more": false,
              "url": "/v1/refunds"
            }
          }
        },
        {
          "tool": "stripe_retrieve_charge",
          "args": {
            "id": "ch_7"
          },
          "expect": {
            "ok": true,
            "data": {
              "id": "ch_7",
              "object": "charge",
              "amount": 2000,
              "amount_captured": 2000,
              "amount_refunded": 500,
              "captured": true,
              "created": 1731640000,
              "currency": "usd",
              "customer": "cus_7",
              "livemode": false,
              "metadata": {
                "order_id": "order_7"
              },
              "paid": true,
              "payment_intent": "pi_7",
              "refunded": false,
              "status": "succeeded"
            }
          }
        }
      ],
      "stateAfter": {
        "/charges/0/amount_refunded": 500,
        "/charges/0/refunded": false,
        "/_sim": {
          "seq": {
            "refund": 1,
            "balance_transaction": 1
          },
          "idempotency": [
            {
              "key": "k1",
              "request": "[\"stripe_create_refund\",{\"amount\":500,\"payment_intent\":\"pi_7\",\"reason\":\"requested_by_customer\"}]",
              "response": {
                "id": "re_000000000000000000000001",
                "object": "refund",
                "amount": 500,
                "balance_transaction": "txn_000000000000000000000001",
                "charge": "ch_7",
                "created": 1731650002,
                "currency": "usd",
                "metadata": {},
                "payment_intent": "pi_7",
                "reason": "requested_by_customer",
                "receipt_number": null,
                "source_transfer_reversal": null,
                "status": "succeeded",
                "transfer_reversal": null
              }
            }
          ]
        }
      }
    },
