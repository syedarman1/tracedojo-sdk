    {
      "name": "input validation",
      "calls": [
        {
          "tool": "stripe_create_refund",
          "args": {},
          "expect": {
            "ok": false,
            "error": {
              "code": "parameter_missing",
              "message": "One of the following params should be provided for this request: payment_intent or charge.",
              "retryable": false
            }
          }
        },
        {
          "tool": "stripe_create_refund",
          "args": {
            "payment_intent": "pi_7",
            "charge": "ch_7"
          },
          "expect": {
            "ok": false,
            "error": {
              "code": "parameters_exclusive",
              "message": "You may only specify one of these parameters: charge, payment_intent.",
              "retryable": false
            }
          }
        },
        {
          "tool": "stripe_retrieve_charge",
          "args": {},
          "expect": {
            "ok": false,
            "error": {
              "code": "parameter_missing",
              "message": "Missing required param: id.",
              "retryable": false
            }
          }
        },
        {
          "tool": "stripe_retrieve_charge",
          "args": {
            "id": "ch_7",
            "expand": [
              "balance_transaction"
            ]
          },
          "expect": {
            "ok": false,
            "error": {
              "code": "parameter_unknown",
              "message": "Received unknown parameter: expand",
              "retryable": false
            }
          }
        },
        {
          "tool": "stripe_create_refund",
          "args": {
            "payment_intent": "pi_7",
            "amount": "5"
          },
          "expect": {
            "ok": false,
            "error": {
              "code": "invalid_request_error",
              "message": "Invalid amount: 5",
              "retryable": false
            }
          }
        },
        {
          "tool": "stripe_create_refund",
          "args": {
            "payment_intent": "pi_7",
            "reason": "changed_mind"
          },
          "expect": {
            "ok": false,
            "error": {
              "code": "invalid_request_error",
              "message": "Invalid reason: changed_mind",
              "retryable": false
            }
          }
        }
      ],
      "stateAfter": {
        "/refunds": []
      }
    },
