    {
      "name": "same idempotency key with different params is rejected",
      "calls": [
        {
          "tool": "stripe_create_refund",
          "args": {
            "payment_intent": "pi_7",
            "amount": 500,
            "idempotency_key": "k1"
          },
          "expect": {
            "ok": true,
            "data": {
              "id": "re_000000000000000000000001",
              "object": "refund",
              "amount": 500,
              "balance_transaction": "txn_000000000000000000000001",
              "charge": "ch_7",
              "created": 1731650002,
              "currency": "usd",
              "metadata": {},
              "payment_intent": "pi_7",
              "reason": null,
              "receipt_number": null,
              "source_transfer_reversal": null,
              "status": "succeeded",
              "transfer_reversal": null
            }
          }
        },
        {
          "tool": "stripe_create_refund",
          "args": {
            "payment_intent": "pi_7",
            "amount": 600,
            "idempotency_key": "k1"
          },
          "expect": {
            "ok": false,
            "error": {
              "code": "idempotency_error",
              "message": "Keys for idempotent requests can only be used with the same parameters they were first used with. Try using a key other than 'k1' if you meant to execute a different request.",
              "retryable": false
            }
          }
        }
      ],
      "stateAfter": {
        "/charges/0/amount_refunded": 500
      }
    },
    {
      "name": "refund more than remains",
      "calls": [
        {
          "tool": "stripe_create_refund",
          "args": {
            "payment_intent": "pi_7",
            "amount": 2501
          },
          "expect": {
            "ok": false,
            "error": {
              "code": "amount_too_large",
              "message": "Refund amount ($25.01) is greater than unrefunded amount on charge ($20.00)",
              "retryable": false
            }
          }
        }
      ],
      "stateAfter": {
        "/refunds": []
      }
    },
    {
      "name": "full refund by charge, then refund again",
      "calls": [
        {
          "tool": "stripe_create_refund",
          "args": {
            "charge": "ch_8"
          },
          "expect": {
            "ok": true,
            "data": {
              "id": "re_000000000000000000000001",
              "object": "refund",
              "amount": 4500,
              "balance_transaction": "txn_000000000000000000000001",
