          "tool": "stripe_create_refund",
          "args": {
            "charge": "ch_8",
            "amount": 1
          },
          "expect": {
            "ok": false,
            "error": {
              "code": "charge_already_refunded",
              "message": "Charge ch_8 has already been refunded.",
              "retryable": false
