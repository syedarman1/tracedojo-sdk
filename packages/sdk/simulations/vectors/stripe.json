          "created": 1731640100,
          "currency": "usd",
          "customer": "cus_8",
          "livemode": false,
          "metadata": {
            "order_id": "order_8"
          },
          "paid": true,
          "payment_intent": "pi_8",
          "refunded": true,
          "status": "succeeded"
        }
      }
    },
    {
      "name": "unknown ids",
      "calls": [
        {
          "tool": "stripe_create_refund",
          "args": {
            "payment_intent": "pi_404"
