    {
      "name": "safe_update with stale stamp is 409",
      "calls": [
        {
          "tool": "zendesk_ticket_update",
          "args": {
            "ticket_id": 35436,
            "ticket": {
              "status": "pending"
            },
            "safe_update": true,
            "updated_stamp": "2024-11-14T12:00:00Z"
          },
          "expect": {
            "ok": true,
            "data": {
              "ticket": {
                "id": 35436,
                "url": "https://shop.zendesk.com/api/v2/tickets/35436.json",
                "subject": "Replacement for order 7?",
                "description": "My mug from order 7 arrived broken. Can you send a replacement?",
                "status": "pending",
                "priority": "normal",
                "requester_id": 501,
                "assignee_id": 9001,
                "tags": [],
                "created_at": "2024-11-14T12:00:00Z",
                "updated_at": "2024-11-15T05:53:20Z"
              }
            }
          }
        },
        {
          "tool": "zendesk_ticket_update",
          "args": {
            "ticket_id": 35436,
            "ticket": {
              "status": "solved"
            },
            "safe_update": true,
            "updated_stamp": "2024-11-14T12:00:00Z"
