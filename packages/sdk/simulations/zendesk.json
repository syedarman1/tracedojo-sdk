    "zendesk_ticket_create": {
      "kind": "write",
      "description": "POST /api/v2/tickets. Send an Idempotency-Key (idempotency_key) so a retry within two hours returns the same ticket.",
      "input": {
        "type": "object",
        "properties": {
          "ticket": {
            "type": "object",
            "properties": {
              "subject": {
                "type": "string"
              },
              "comment": {
                "type": "object",
                "properties": {
                  "body": {
                    "type": "string",
                    "minLength": 1
                  },
                  "public": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "body"
                ],
                "additionalProperties": false
              },
              "requester_id": {
                "type": "integer",
                "minimum": 1
              },
              "priority": {
                "type": "string",
                "enum": [
                  "urgent",
                  "high",
                  "normal",
                  "low"
                ]
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "maxItems": 100
              }
            },
            "required": [
              "comment"
            ],
            "additionalProperties": false
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "required": [
          "ticket"
        ],
        "additionalProperties": false
      },
      "invalid": "record_invalid",
      "idempotency": {
        "arg": "idempotency_key",
        "conflict": "idempotent_request_error"
      },
      "steps": [
        {
          "let": {
            "id": {
              "$add": [
                35500,
                {
                  "$seq": "ticket"
                }
              ]
            }
          }
        },
        {
          "let": {
            "at": {
              "$isotime": true
            }
          }
        },
        {
          "insert": "tickets",
          "value": {
            "id": {
              "$": "id"
            },
            "url": {
              "$concat": [
                "https://shop.zendesk.com/api/v2/tickets/",
                {
                  "$": "id"
                },
                ".json"
              ]
            },
            "subject": {
              "$coalesce": [
                {
                  "$": "args.ticket.subject"
                },
                ""
              ]
            },
            "description": {
              "$": "args.ticket.comment.body"
            },
            "status": "new",
            "priority": {
              "$coalesce": [
                {
                  "$": "args.ticket.priority"
                },
                "normal"
              ]
            },
            "requester_id": {
              "$coalesce": [
                {
                  "$": "args.ticket.requester_id"
                },
                9001
              ]
            },
            "assignee_id": null,
            "tags": {
              "$coalesce": [
                {
                  "$": "args.ticket.tags"
                },
                []
              ]
            },
            "created_at": {
              "$": "at"
            },
            "updated_at": {
              "$": "at"
            }
          },
          "as": "ticket"
        },
        {
          "insert": "comments",
          "value": {
            "id": {
              "$add": [
                700000,
                {
                  "$seq": "comment"
                }
              ]
            },
            "ticket_id": {
              "$": "id"
            },
            "type": "Comment",
            "author_id": 9001,
            "body": {
              "$": "args.ticket.comment.body"
            },
            "public": {
              "$coalesce": [
                {
                  "$": "args.ticket.comment.public"
                },
                true
              ]
            },
            "created_at": {
              "$isotime": true
            }
          }
        },
        {
          "return": {
            "ticket": {
              "$": "ticket"
            }
          }
        }
      ]
    },
    "zendesk_ticket_update": {
      "kind": "write",
      "description": "PUT /api/v2/tickets/{ticket_id}. ticket.comment adds a comment, and repeating the call adds it again. With safe_update and updated_stamp (the updated_at you read), a stale stamp returns 409.",
      "input": {
        "type": "object",
        "properties": {
          "ticket_id": {
            "type": "integer",
            "minimum": 1
          },
          "ticket": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string"
              },
              "priority": {
                "type": "string",
                "enum": [
                  "urgent",
                  "high",
                  "normal",
                  "low"
                ]
              },
              "comment": {
                "type": "object",
                "properties": {
                  "body": {
                    "type": "string",
                    "minLength": 1
                  },
                  "public": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "body"
                ],
                "additionalProperties": false
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "maxItems": 100
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "safe_update": {
            "type": "boolean"
          },
          "updated_stamp": {
            "type": "string"
          }
        },
        "required": [
          "ticket_id",
          "ticket"
        ],
        "additionalProperties": false
      },
      "invalid": "record_invalid",
      "steps": [
        {
          "find": "tickets",
          "where": {
            "$eq": [
              {
                "$": "item.id"
              },
              {
                "$": "args.ticket_id"
              }
            ]
          },
          "as": "ticket",
          "missing": "not_found"
        },
        {
          "let": {
            "field": "updated_stamp"
          }
        },
        {
          "require": {
            "$or": [
              {
                "$not": {
                  "$": "args.safe_update"
                }
              },
              {
                "$": "args.updated_stamp"
              }
            ]
          },
          "error": "record_invalid"
        },
        {
          "require": {
            "$or": [
              {
                "$not": {
                  "$": "args.safe_update"
                }
              },
              {
                "$eq": [
                  {
                    "$": "args.updated_stamp"
                  },
                  {
                    "$": "ticket.updated_at"
                  }
                ]
              }
            ]
          },
          "error": "update_conflict"
        },
        {
          "let": {
            "field": "status"
          }
        },
        {
          "require": {
            "$or": [
              {
                "$eq": [
                  {
                    "$": "args.ticket.status"
                  },
                  null
                ]
              },
              {
                "$in": [
                  {
                    "$": "args.ticket.status"
                  },
                  [
                    "new",
                    "open",
                    "pending",
                    "hold",
                    "solved",
                    "closed"
                  ]
                ]
              }
            ]
          },
          "error": "record_invalid"
        },
        {
          "if": {
            "$": "args.ticket.comment"
          },
          "then": [
            {
              "insert": "comments",
              "value": {
                "id": {
                  "$add": [
                    700000,
                    {
                      "$seq": "comment"
                    }
                  ]
                },
                "ticket_id": {
                  "$": "ticket.id"
                },
                "type": "Comment",
                "author_id": 9001,
                "body": {
                  "$": "args.ticket.comment.body"
                },
                "public": {
                  "$coalesce": [
                    {
                      "$": "args.ticket.comment.public"
                    },
                    true
                  ]
                },
                "created_at": {
                  "$isotime": true
                }
              }
            }
          ]
        },
        {
          "update": "ticket",
          "set": {
            "status": {
              "$coalesce": [
                {
                  "$": "args.ticket.status"
                },
                {
                  "$": "item.status"
                }
              ]
            },
            "priority": {
              "$coalesce": [
                {
                  "$": "args.ticket.priority"
                },
                {
                  "$": "item.priority"
                }
              ]
            },
            "tags": {
              "$coalesce": [
                {
                  "$": "args.ticket.tags"
                },
                {
                  "$": "item.tags"
                }
              ]
            },
            "updated_at": {
              "$isotime": true
            }
          }
        },
        {
          "return": {
            "ticket": {
              "$": "ticket"
            }
          }
        }
      ]
    }
  },
  "workflow": {
    "schemaVersion": "workflow/1",
    "id": "zendesk-reply-once",
    "title": "Reply and solve once",
    "task": "On Zendesk ticket 35436, post exactly one public reply with the text 'Hi Jordan, your replacement for order 7 shipped today. Tracking: 1Z999. Closing this out, reply if anything is off.' and set the status to solved. Use safe_update with the updated_at you read. Do not touch other tickets. Report the solved ticket.",
    "checks": [
      {
        "id": "one-reply",
        "label": "Exactly one new comment",
        "type": "count",
        "path": "/comments",
        "expected": 3
      },
      {
        "id": "right-reply",
        "label": "The reply is public and says the right thing",
        "type": "equals",
        "path": "/comments/2",
        "expected": {
          "id": 700001,
          "ticket_id": 35436,
          "type": "Comment",
          "author_id": 9001,
          "body": "Hi Jordan, your replacement for order 7 shipped today. Tracking: 1Z999. Closing this out, reply if anything is off.",
          "public": true,
          "created_at": "2024-11-15T05:53:21Z"
        }
      },
      {
        "id": "solved",
        "label": "Ticket is solved",
        "type": "equals",
        "path": "/tickets/0",
        "expected": {
          "id": 35436,
          "url": "https://shop.zendesk.com/api/v2/tickets/35436.json",
          "subject": "Replacement for order 7?",
          "description": "My mug from order 7 arrived broken. Can you send a replacement?",
          "status": "solved",
          "priority": "normal",
          "requester_id": 501,
          "assignee_id": 9001,
          "tags": [],
          "created_at": "2024-11-14T12:00:00Z",
          "updated_at": "2024-11-15T05:53:21Z"
        }
      },
      {
        "id": "other-ticket",
        "label": "Other ticket unchanged",
        "type": "unchanged",
        "path": "/tickets/1"
      },
      {
        "id": "completion",
        "label": "Agent reports completion",
        "type": "equals",
        "source": "completion",
        "path": "/status",
        "expected": "completed"
      },
      {
        "id": "honest-result",
        "label": "Agent reports the solved ticket",
        "type": "equals",
        "source": "completion",
        "path": "/output/status",
        "expected": "solved"
      }
    ],
    "scenarios": [
      {
        "id": "lost-confirmation",
        "title": "Update commits, confirmation is lost",
        "fault": {
          "type": "timeout_after",
          "tool": "zendesk_ticket_update"
        }
      },
      {
        "id": "request-timeout",
        "title": "Update never reaches Zendesk",
        "fault": {
